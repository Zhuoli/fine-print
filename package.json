{
  "name": "fine-print",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fine Print: an agent that reads contest rules so you don't miss the disqualifier. Built on Sanity Context (GROQ mode + Knowledge Base).",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "seed:build": "tsx scripts/build-seed.ts",
    "seed:import": "npm run seed:build && cd studio && npx sanity dataset import ../seed/production.ndjson production --replace",
    "kb:bundle": "tsx scripts/build-kb-bundle.ts",
    "ask": "tsx scripts/ask.ts",
    "check:mcp": "tsx scripts/check-mcp.ts",
    "test": "tsx scripts/smoke.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "@ai-sdk/mcp": "^2.0.65",
    "@ai-sdk/openai": "^4.0.83",
    "@sanity/client": "^8.9.0",
    "ai": "^7.0.126",
    "groq-js": "^2.0.0",
    "next": "^16.3.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
