# --- Sanity project (public dataset is fine; no token needed to read) ---
SANITY_PROJECT_ID=your-project-id
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-24
# Only if the dataset is private:
SANITY_API_READ_TOKEN=
# Studio reads these (studio/.env or shell):
SANITY_STUDIO_PROJECT_ID=your-project-id
SANITY_STUDIO_DATASET=production

# --- Sanity Context MCP (Context app in the Dashboard) ---
# Must be an ORGANIZATION token with Context Viewer. A project token gets 403 contextGrantRequired.
SANITY_ORGANIZATION_TOKEN=your-org-token
# MCP whose source is the dataset (GROQ mode)
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v1/context/organizations/your-org-id/mcp/fine-print-groq
# MCP whose source is the Knowledge Base (Knowledge Base mode)
SANITY_CONTEXT_KB_MCP_URL=https://api.sanity.io/v1/context/organizations/your-org-id/mcp/fine-print-kb

# --- LLM (one of these). Without either, the app runs a deterministic keyword planner. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FINE_PRINT_MODEL=
