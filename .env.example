# --- Sanity project (public dataset is fine; no token needed to read) ---
SANITY_PROJECT_ID=9wt4tu94
SANITY_DATASET=production
SANITY_API_VERSION=2026-09-24
# Only if the dataset is private:
SANITY_API_READ_TOKEN=
# Studio reads these (studio/.env or shell):
SANITY_STUDIO_PROJECT_ID=9wt4tu94
SANITY_STUDIO_DATASET=production

# --- Sanity Context MCP ---
# Project-level Context endpoint over the full dataset (works on the Free plan with a project Viewer token;
# falls back to SANITY_API_READ_TOKEN if no token below is set):
SANITY_CONTEXT_MCP_URL=https://api.sanity.io/v2026-03-03/context/mcp/9wt4tu94/production?embeddings=true
# Org-level Context app endpoints need an ORGANIZATION token with Context Viewer (a project token gets 403 contextGrantRequired):
SANITY_ORGANIZATION_TOKEN=
# Org-level GROQ MCP alternative: https://api.sanity.io/v1/context/organizations/otr7jib55/mcp/fine-print-groq
# MCP whose source is the Knowledge Base (Knowledge Base mode)
SANITY_CONTEXT_KB_MCP_URL=https://api.sanity.io/v1/context/organizations/otr7jib55/mcp/fine-print-kb

# --- LLM (one of these). Without either, the app runs a deterministic keyword planner. ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FINE_PRINT_MODEL=
